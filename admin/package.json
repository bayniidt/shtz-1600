{
  "name": "adfly-admin-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ADFLY 管理后台前端（React 18 + Ant Design Pro + Vite + Tailwind）",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --testTimeout=60000 --maxWorkers=1 --minWorkers=1 --no-file-parallelism",
    "test:smoke": "node scripts/smoke.mjs",
    "lint": "echo \"(eslint not configured yet)\""
  },
  "dependencies": {
    "@ant-design/charts": "^2.2.3",
    "@ant-design/icons": "^5.6.1",
    "@ant-design/pro-components": "^2.8.2",
    "antd": "^5.22.7",
    "axios": "^1.7.9",
    "dayjs": "^1.11.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "axios-mock-adapter": "^2.1.0",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
