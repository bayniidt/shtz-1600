# 复制到项目根目录 .env 后填写：docker compose up -d --build

# 对外入口，例如 https://www.example.com
CORS_ORIGIN=https://www.example.com
HTTP_PORT=80

# 必须使用至少 32 个字符的强随机值，不要使用默认值或占位文本
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=12h

# 首次启动创建的管理员账号；生产环境必须填写 bcrypt hash
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# 部署前执行：node deploy/verify-production-env.mjs .env

# 可选：调整登录限流和文档开关
LOGIN_RATE_WINDOW_MINUTES=15
LOGIN_RATE_MAX_ATTEMPTS=10
SWAGGER_ENABLED=false
